# The dev toolchain pulls two incompatible @swc/helpers ranges via transitive
# peer deps (@swc/core wants >=0.5.17, another consumer pins 0.5.15). npm 7+'s
# strict peer resolver aborts on this even though it's harmless. Relax it so
# `npm install <pkg>` doesn't fail on every new dependency.
legacy-peer-deps=true
