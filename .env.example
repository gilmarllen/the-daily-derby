# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and never committed.

# --- Supabase (auth + database) ---
# Project URL and keys: Supabase dashboard → Project Settings → API Keys.
# Uses the new key format (publishable/secret), not the legacy anon/service_role.
NEXT_PUBLIC_SUPABASE_URL=
# Public, client-safe key — starts with `sb_publishable_`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key — starts with `sb_secret_`. Never expose to the client.
SUPABASE_SECRET_KEY=

# --- Social login (Supabase OAuth) ---
# Only needed for LOCAL `supabase start`; in production set these in the
# Supabase dashboard (Authentication → Providers). Each provider is disabled in
# config.toml until you flip `enabled = true` there. Register an OAuth app on
# each provider's console and set the callback to
# https://<project-ref>.supabase.co/auth/v1/callback (locally
# http://127.0.0.1:54321/auth/v1/callback). X is keyed as `twitter`.
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_TWITTER_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_TWITTER_SECRET=

# --- Odds / fixtures provider (https://odds-api.io/) ---
ODDS_API_KEY=
# Single bookmaker to source fixtures + 1X2 odds from. The match sync filters
# events to this bookmaker, so only matches it covers enter the pool.
# Defaults to `Bet365` when unset.
ODDS_API_BOOKMAKER=

# --- Cron ---
# Shared secret protecting the cron routes (fixture sync, team-crest sync, daily
# income, etc.). Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
# When unset, the routes are unprotected (fine for local dev only). Generate one
# with: openssl rand -hex 32
CRON_SECRET=

# --- Site ---
# Canonical absolute site URL (no trailing slash), used for OG/Twitter metadata
# and other absolute links. Defaults to the production Vercel URL when unset.
NEXT_PUBLIC_SITE_URL=

# --- Feature flags ---
# Show a "coming soon" watermark over the Missions page. Set to `true` in
# deployed environments; leave unset locally to develop the real page.
NEXT_PUBLIC_MISSIONS_COMING_SOON=

