# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and never committed.

# --- Supabase (auth + database) ---
# Project URL and keys: Supabase dashboard → Project Settings → API Keys.
# Uses the new key format (publishable/secret), not the legacy anon/service_role.
NEXT_PUBLIC_SUPABASE_URL=
# Public, client-safe key — starts with `sb_publishable_`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key — starts with `sb_secret_`. Never expose to the client.
SUPABASE_SECRET_KEY=

# --- Odds / fixtures provider (https://odds-api.io/) ---
ODDS_API_KEY=
